{
  "name": "play-bots",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bad-manners": "node scripts/badMannersBridge.mjs",
    "test:bad-manners": "node scripts/badMannersGauntlet.mjs --limit=200",
    "test:bad-manners:compare": "node scripts/badMannersGauntlet.mjs --limit=80 --compare",
    "test:bad-manners:local": "node scripts/badMannersLocalCompare.mjs",
    "build": "vite build",
    "build:recent-book": "node scripts/buildRecentRepertoireBook.mjs --profile ayden",
    "build:repertoires": "node scripts/buildRecentRepertoireBook.mjs --profile all",
    "test": "node --test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.5",
    "stockfish": "^18.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.59.1",
    "vite": "^8.0.10"
  }
}
